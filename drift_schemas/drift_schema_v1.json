  "fixed_sql": [
    {
      "name": "battery_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"battery_profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"capacity_wh\" REAL NOT NULL, \"default_connection_type\" TEXT NOT NULL DEFAULT 'AC', \"current_charge_percent\" REAL NOT NULL DEFAULT 100.0, \"max_continuous_output_w\" REAL NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "custom_appliances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_appliances\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"watts\" REAL NOT NULL, \"usage_pattern\" TEXT NOT NULL DEFAULT 'alwaysOn', \"custom_usage_factor\" REAL NULL, \"category\" TEXT NOT NULL DEFAULT 'other', \"connection_override\" TEXT NULL, \"has_startup_surge\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_startup_surge\" IN (0, 1)), \"is_medical_related\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_medical_related\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "setups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"setups\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"mode\" TEXT NOT NULL, \"battery_profile_id\" TEXT NULL, \"capacity_wh_snapshot\" REAL NULL, \"charge_percent_snapshot\" REAL NULL, \"connection_type\" TEXT NOT NULL DEFAULT 'AC', \"desired_runtime_hours\" REAL NULL, \"reserve_floor_percent\" REAL NOT NULL DEFAULT 10.0, \"custom_efficiency\" REAL NULL, \"max_continuous_output_w\" REAL NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "setup_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"setup_items\" (\"id\" TEXT NOT NULL, \"setup_id\" TEXT NOT NULL REFERENCES setups (id) ON DELETE CASCADE, \"source_appliance_id\" TEXT NULL, \"name_snapshot\" TEXT NOT NULL, \"watts_snapshot\" REAL NOT NULL, \"usage_factor_snapshot\" REAL NOT NULL, \"usage_pattern_snapshot\" TEXT NOT NULL DEFAULT 'alwaysOn', \"connection_override\" TEXT NULL, \"has_startup_surge\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_startup_surge\" IN (0, 1)), \"is_medical_related\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_medical_related\" IN (0, 1)), \"category_snapshot\" TEXT NOT NULL DEFAULT 'other', \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
